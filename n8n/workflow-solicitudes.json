    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1c1c1c1-1111-4111-8111-111111111111",
              "leftValue": "={{ $json['Correo electrónico'] || $json['Dirección de correo electrónico'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c1c1c1c1-2222-4222-8222-222222222222",
              "leftValue": "={{ $json['Folio'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [880, 40],
      "id": "a1b2c3d4-0003-4a5b-8c9d-000000000003",
      "name": "Solo solicitudes nuevas"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza la fila de Google Sheets y arma el cuerpo para la API\nconst fila = $json;\nconst texto = (v) => (v === undefined || v === null ? '' : String(v).trim());\n\nconst correo = texto(fila['Correo electrónico'] || fila['Dirección de correo electrónico']).toLowerCase();\nconst nombre = texto(fila['Nombre completo']);\nconst descripcion = texto(fila['Descripción del problema']);\n\n// Si la fila esta incompleta se ignora\nif (!correo || !nombre || !descripcion) {\n  return [];\n}\n\nconst hoja = '__SPREADSHEET_ID__';\n\nreturn [{\n  json: {\n    row_number: fila.row_number,\n    nombre,\n    correo,\n    telefono: texto(fila['Teléfono']) || null,\n    categoria: texto(fila['Categoría']) || 'Otro',\n    prioridad: texto(fila['Prioridad']) || 'Media',\n    descripcion,\n    ubicacion: texto(fila['Ubicación / equipo']) || null,\n    origen: 'Google Forms',\n    clave_origen: 'sheet:' + hoja + ':' + fila.row_number,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 40],
      "id": "a1b2c3d4-0004-4a5b-8c9d-000000000004",
      "name": "Preparar solicitud"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "__API_URL__/api/solicitudes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 40],
      "id": "a1b2c3d4-0005-4a5b-8c9d-000000000005",
      "name": "Registrar en la API",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Solo continuamos si la API devolvio un JSON valido con folio.\n// Si Render esta despertando (pagina HTML de carga), la fila queda\n// sin procesar y se reintenta en el siguiente ciclo.\nconst salida = $json;\nlet crudo = salida && salida.data !== undefined ? salida.data : salida;\n\nif (typeof crudo === 'string') {\n  const t = crudo.trim();\n  if (!t.startsWith('{')) return [];\n  try { crudo = JSON.parse(t); } catch (e) { return []; }\n}\n\nif (!crudo || crudo.ok !== true || !crudo.data || !crudo.data.folio) {\n  return [];\n}\n\nreturn [{ json: crudo.data }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 40],
      "id": "a1b2c3d4-0008-4a5b-8c9d-000000000008",
      "name": "Validar respuesta de la API"
    },
