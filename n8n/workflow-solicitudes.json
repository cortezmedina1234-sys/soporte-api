        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; color:#1f2937; max-width:600px\">\n  <h2 style=\"color:#0f766e; margin-bottom:4px\">Solicitud de soporte registrada</h2>\n  <p style=\"margin-top:0\">Hola <strong>{{ $('Preparar solicitud').item.json.nombre }}</strong>, recibimos tu solicitud.</p>\n  <table cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse; width:100%; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px\">\n    <tr><td><strong>Folio</strong></td><td>{{ $json.folio }}</td></tr>\n    <tr><td><strong>Categoria</strong></td><td>{{ $json.categoria }}</td></tr>\n    <tr><td><strong>Prioridad</strong></td><td>{{ $json.prioridad }}</td></tr>\n    <tr><td><strong>Estado</strong></td><td>{{ $json.estado }}</td></tr>\n    <tr><td><strong>Fecha</strong></td><td>{{ $json.fecha_solicitud }}</td></tr>\n    <tr><td><strong>Descripcion</strong></td><td>{{ $json.descripcion }}</td></tr>\n  </table>\n  <p style=\"font-size:13px; color:#64748b; margin-top:16px\">Conserva tu folio para dar seguimiento. El area de soporte tecnico atendera tu solicitud en el menor tiempo posible.</p>\n</div>",
        "options": {
